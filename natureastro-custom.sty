\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{natureastro-look}[2026/09/22 Unofficial Nature Astronomy-inspired writing layout]
% ============================================================
% Package options
% ============================================================
\newif\ifNAauthoryear
\NAauthoryearfalse

\DeclareOption{authoryear}{\NAauthoryeartrue}

% Nature-like headings are the default.
% Use [revtexheadings] for APS/REVTeX-style numbered headings.
\newif\ifNArevtexheadings
\NArevtexheadingsfalse

\DeclareOption{revtexheadings}{\NArevtexheadingstrue}
\DeclareOption{natureheadings}{\NArevtexheadingsfalse}

\ProcessOptions\relax

% ============================================================
% Page geometry
% ============================================================
\RequirePackage[a4paper,top=17mm,bottom=18mm,left=17mm,right=17mm,headheight=9pt,headsep=6pt,footskip=12mm]{geometry}

% ============================================================
% Text typography
% ============================================================
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{microtype}
% Older/author-manuscript Nature appearance
% \RequirePackage{newtxtext}
% Harding-like approximation:
% Nature itself specifies Palatino as the fallback for Harding.
\RequirePackage{newpxtext}

% ============================================================
% Mathematics
% ============================================================
\RequirePackage{amsmath,amssymb}
% \RequirePackage{newtxmath}
\RequirePackage{newpxmath}
% Bold mathematical symbols, including Greek.
\RequirePackage{bm}
% Upright Greek symbols.
\RequirePackage{upgreek}
% Notation conventions:
%   vectors  -> bold italic
%   matrices -> bold upright
%   tensors  -> bold upright
\newcommand{\vect}[1]{\bm{#1}}
\newcommand{\mat}[1]{\mathbf{#1}}
\newcommand{\tens}[1]{\mathbf{#1}}

% ============================================================
% Figures, tables, and lists
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{caption}
\RequirePackage{enumitem}

% ============================================================
% Citations and bibliography
% ============================================================
\ifNAauthoryear
% AAS/ApJ-style author-year citations.
\RequirePackage[authoryear,round]{natbib}
\else
% Nature-style numerical superscript citations.
\RequirePackage[super,sort&compress]{natbib}
\fi
% Bibliography heading and typography.
\renewcommand{\bibsection}{
\section*{References}}
\renewcommand{\bibfont}{\fontsize{7.15}{8.25}\selectfont}

% ============================================================
% Document utilities
% ============================================================
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
% Load hyperlinks after the other style-level packages.
\RequirePackage{hyperref}
\RequirePackage{cuted}

% ============================================================
% Global spacing and layout
% ============================================================
\linespread{0.96}
\setlength{\columnsep}{5.2mm}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\setlength{\bibsep}{1.1pt plus .2ex}
\setlist{nosep,leftmargin=*}
% ============================================================
% Full-width text in two-column layout
% ============================================================
% REVTeX-like widetext environment implemented using cuted.
% Intended primarily for wide equations and aligned expressions.
\setlength{\stripsep}{10pt plus 2pt minus 2pt}
\newenvironment{widetext}
{
\begin{strip}}
  {
\end{strip}}

% ============================================================
% Colour and hyperlinks
% ============================================================
\definecolor{NAgray}{HTML}{555555}
\definecolor{NAlink}{HTML}{245B85}
\hypersetup{colorlinks=true,citecolor=NAlink,linkcolor=NAlink,urlcolor=NAlink,pdfborder={0 0 0}}

% ============================================================
% Running header and footer
% ============================================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\fontsize{7.2}{8.2}\selectfont\color{NAgray}\na@runninghead}
\fancyfoot[R]{\fontsize{7.2}{8.2}\selectfont\color{NAgray}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ============================================================
% Section headings
% ============================================================

\ifNArevtexheadings
% ----------------------------------------------------------
% APS/REVTeX-inspired section hierarchy
% ----------------------------------------------------------
% REVTeX numbering convention:
%   section       -> I., II., III., ...
%   subsection    -> A., B., C., ...
%   subsubsection -> 1., 2., 3., ...
\renewcommand{\thesection}{\Roman{section}}
\renewcommand{\thesubsection}{\Alph{subsection}}
\renewcommand{\thesubsubsection}{\arabic{subsubsection}}

% Level 1: centred, bold, uppercase.
\titleformat{\section}
{\normalfont\small\bfseries\centering}{\thesection.}{0.6em}{\MakeUppercase}

\titlespacing*{\section}
{0pt}{0.8cm plus 1ex minus 0.2ex}{0.5cm}

% Level 2: centred and bold.
\titleformat{\subsection}
{\normalfont\small\bfseries\centering}{\thesubsection.}{0.6em}{}

\titlespacing*{\subsection}
{0pt}{0.8cm plus 1ex minus 0.2ex}{0.5cm}

% Level 3: centred and italic.
\titleformat{\subsubsection}
{\normalfont\small\itshape\centering}{\thesubsubsection.}{0.6em}{}

\titlespacing*{\subsubsection}
{0pt}{0.8cm plus 1ex minus 0.2ex}{0.5cm}

\else
% ----------------------------------------------------------
% Nature Astronomy-inspired section hierarchy
% ----------------------------------------------------------
\titleformat{\section}
{\bfseries\fontsize{9.4}{10.8}\selectfont}{}{0pt}{}

\titlespacing*{\section}
{0pt}{1.15em}{0.35em}

\titleformat{\subsection}
{\bfseries\fontsize{8.7}{10.1}\selectfont}
{}{0pt}{}

\titlespacing*{\subsection}
{0pt}{1.0em}{0.25em}

\titleformat{\subsubsection}
{\itshape\fontsize{8.3}{9.6}\selectfont}
{}{0pt}{}

\titlespacing*{\subsubsection}
{0pt}{0.8em}{0.2em}

\fi

% ============================================================
% Figure and table captions
% ============================================================
\DeclareCaptionFont{nasize}{\fontsize{7.4}{8.8}\selectfont}
\captionsetup{font=nasize,labelfont=bf,labelsep=period,justification=justified,singlelinecheck=false,skip=4pt}

% ============================================================
% Body and reference typography
% ============================================================
\AtBeginDocument{\fontsize{8.25}{10.05}\selectfont}
\AtBeginEnvironment{thebibliography}{\fontsize{7.25}{8.35}\selectfont}

\makeatletter
% ============================================================
% Internal metadata storage
% ============================================================
\newcommand{\na@runninghead}{}
\newcommand{\na@affiliations}{}
\newcommand{\na@correspondence}{}
\newcommand{\runninghead}[1]{\renewcommand{\na@runninghead}{#1}}
\newcommand{\affiliations}[1]{\renewcommand{\na@affiliations}{#1}}
\newcommand{\correspondence}[1]{\renewcommand{\na@correspondence}{#1}}

% ============================================================
% Journal masthead
% ============================================================
\newcommand{\namasthead}{%
  {\fontsize{19}{19}\selectfont\bfseries nature\hspace{0.18em}\mdseries astronomy}\par
  \vspace{1.5mm}
  \rule{\textwidth}{0.55pt}\par
  \vspace{5mm}
}

% ============================================================
% Title block
% ============================================================
\renewcommand{\maketitle}{%
  \twocolumn[{%
      \begin{@twocolumnfalse}
        % \namasthead
        \begin{minipage}[t]{0.74\textwidth}
          {\fontsize{20.5}{23.0}\selectfont\bfseries\raggedright \@title\par}
          \vspace{3.5mm}
          {\fontsize{9.0}{11.0}\selectfont\raggedright \@author\par}
          \vspace{4.5mm}
          {\fontsize{10.1}{12.5}\selectfont\raggedright \@abstract\par}
        \end{minipage}
        \vspace{6mm}
      \end{@twocolumnfalse}
  }]
  \thispagestyle{fancy}
}

% ============================================================
% Abstract handling
% ============================================================
\renewenvironment{abstract}{\global\let\@abstract\@empty\collect@body\na@setabstract}{}
\newcommand{\na@setabstract}[1]{\gdef\@abstract{#1}}
\providecommand{\@abstract}{}

% ============================================================
% End matter
% ============================================================
\newcommand{\makeendmatter}{%
  \par\vspace{1.0em}
  \begingroup\fontsize{7.35}{8.7}\selectfont
  \ifstrempty{\na@affiliations}{}{\noindent\textbf{Affiliations}\par\na@affiliations\par\medskip}
  \ifstrempty{\na@correspondence}{}{\noindent\textbf{Correspondence}\par\na@correspondence\par\medskip}
  \endgroup
}

% ============================================================
% Manuscript section helpers
% ============================================================
\newcommand{\methods}{
\section*{Methods}}
\newcommand{\dataavailability}{
\section*{Data availability}}
\newcommand{\codeavailability}{
\section*{Code availability}}
\newcommand{\acknowledgements}{
\section*{Acknowledgements}}
\newcommand{\authorcontributions}{
\section*{Author contributions}}
\newcommand{\competinginterests}{
\section*{Competing interests}}

\makeatother
